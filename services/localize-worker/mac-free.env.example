# Example env for the free (and the local half of economy) tier on the Mac mini.
# Isolated tree: /Volumes/Data/localize-free (do not install into system Python,
# MoneyPrinterTurbo, or /Volumes/Data/voice-pipeline).
#
#   source /Volumes/Data/localize-free/env.sh
#   set -a; source /path/to/this/file; set +a
#
# Then start the localize worker. Missing tools still fail with engine_not_configured.
# This file has no secrets and no paid-vendor keys.

LINES_LOCAL_TTS=namaa
LINES_NAMAA_TTS_CMD=/Volumes/Data/localize-free/bin/namaa-tts
LINES_MUSETALK_CMD=/Volumes/Data/localize-free/bin/musetalk-run
# Fallback / comparison voice (MSA-leaning, needs internet):
LINES_EDGE_TTS_BIN=/Volumes/Data/localize-free/venvs/edge/bin/edge-tts
LINES_EDGE_VOICE=ar-SA-HamedNeural
LINES_FFMPEG=/opt/homebrew/bin/ffmpeg
LINES_FFPROBE=/opt/homebrew/bin/ffprobe
